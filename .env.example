# PostgreSQL connection used by the API and Drizzle.
# For Supabase, use the transaction pooler connection string from
# Project Settings > Database (port 6543), with SSL enabled.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=require

# Keep the serverless pool small. Increase only if your Supabase plan allows it.
PG_POOL_MAX=1